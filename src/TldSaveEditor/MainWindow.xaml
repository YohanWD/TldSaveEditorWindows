<Window x:Class="TldSaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLD Survival Save Editor" Height="700" Width="1150"
        Closing="Window_Closing">
    <Window.Resources>
        <FontFamily x:Key="Mono">Consolas</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Open file…" Click="OpenFile_Click" />
            <Button x:Name="SaveButton" Content="Save (with backup)" Click="Save_Click" IsEnabled="False" FontWeight="Bold" />
            <Separator Margin="6,0,12,0" />
            <Button Content="Backup now" Click="BackupNow_Click"
                    ToolTip="Copy the selected save file to the backup folder, without changing it. Safe while the game is running: it copies the game's last save." />
            <Button Content="Restore backup…" Click="RestoreBackup_Click" />
            <Button Content="Open backups folder" Click="OpenBackups_Click" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Ready" />
        </StatusBar>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Survival saves -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Surival svaves" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox x:Name="SavesList" SelectionChanged="SavesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Foreground="Gray" FontSize="11">
                                    <Run Text="{Binding FileName, Mode=OneWay}" /> · <Run Text="{Binding Timestamp, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl x:Name="Tabs" Grid.Column="2" IsEnabled="False">
                <!-- Overview -->
                <TabItem Header="Overview">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Name" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Text="File" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileText" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Experience mode" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="XpModeText" />
                        <TextBlock Grid.Row="3" Text="Region / scene" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RegionText" />
                        <TextBlock Grid.Row="4" Text="Days survived" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DaysText" />
                        <TextBlock Grid.Row="5" Text="Condition" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ConditionText" />
                        <TextBlock Grid.Row="6" Text="Last saved" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TimestampText" />
                        <TextBlock Grid.Row="7" Text="Visited scenes" />
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ScenesText" />
                    </Grid>
                </TabItem>

                <!-- Player -->
                <TabItem Header="Player">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="PlayerPanel" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                                <Style TargetType="Slider">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="IsMoveToPointEnabled" Value="True" />
                                    <Setter Property="Margin" Value="6,0" />
                                </Style>
                                <Style x:Key="ValueBox" TargetType="TextBox">
                                    <Setter Property="Width" Value="60" />
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </Grid.Resources>

                            <!-- Left column: status + cheats -->
                            <StackPanel>
                                <GroupBox Header="Status">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Condition %" VerticalAlignment="Center" />
                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="{Binding ConditionMax, Mode=OneWay}"
                                                    Value="{Binding Condition}" />
                                            <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueBox}"
                                                     Text="{Binding Condition, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Grid.Row="1" Text="Calories (0 = starving)" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2500" Value="{Binding Calories}" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueBox}"
                                                     Text="{Binding Calories, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Grid.Row="2" Text="Thirst (0 = hydrated)" VerticalAlignment="Center" />
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Thirst}" />
                                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueBox}"
                                                     Text="{Binding Thirst, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Grid.Row="3" Text="Fatigue (0 = rested)" VerticalAlignment="Center" />
                                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fatigue}" />
                                            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueBox}"
                                                     Text="{Binding Fatigue, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Grid.Row="4" Text="Freezing (0 = warm)" VerticalAlignment="Center" />
                                            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Freezing}" />
                                            <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueBox}"
                                                     Text="{Binding Freezing, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding WellFed}"
                                                  Content="Well Fed (+5 max condition)" />
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="RestoreAll_Click"
                                                Content="Restore all: full health, fed, hydrated, rested, warm" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Cheats">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Invulnerable}" Content="Invulnerable" />
                                        <CheckBox IsChecked="{Binding NeverDie}" Content="Never die" Margin="0,4,0,0" />
                                        <TextBlock Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Flags from the original editor. Not tested in game." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- Right column: skills + afflictions -->
                            <StackPanel Grid.Column="2">
                                <GroupBox Header="Skills">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Skills}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="30" IsEnabled="{Binding Exists}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxPoints}"
                                                                Value="{Binding Points}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="Gray">
                                                            <Run Text="{Binding Points, Mode=OneWay}" /> / <Run Text="{Binding MaxPoints, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding LevelText}" VerticalAlignment="Center"
                                                                   Margin="8,0,0,0" />
                                                        <Button Grid.Column="4" Content="Max" Click="MaxSkill_Click" Margin="0" Padding="8,1" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Max all skills (level 5)"
                                                Click="MaxAllSkills_Click" />
                                        <TextBlock Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Skills are stored as points. Level 5 = the max shown. Lower level thresholds are only known for Fire starting and Cooking." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Afflictions">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Afflictions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="Gray" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="Firebrick" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="2" Content="Cure" Click="Cure_Click" Margin="0" Padding="8,1"
                                                                IsEnabled="{Binding IsActive}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Cure all" Click="CureAll_Click" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Inventory -->
                <TabItem Header="Inventory">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Add item…" Click="AddItem_Click" Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch" />
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Left" Width="150" Margin="0,0,6,0"
                                          SelectionChanged="CategoryFilter_SelectionChanged" />
                                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" VerticalContentAlignment="Center"
                                         ToolTip="Filter by name" />
                            </DockPanel>
                            <ListBox x:Name="ItemsList" SelectionChanged="ItemsList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Margin="0,2">
                                                                <Expander.Style>
                                                                    <Style TargetType="Expander">
                                                                        <Setter Property="IsExpanded" Value="True" />
                                                                        <Style.Triggers>
                                                                            <!-- Rarely edited groups start collapsed -->
                                                                            <DataTrigger Binding="{Binding Name}" Value="Notes &amp; collectibles">
                                                                                <Setter Property="IsExpanded" Value="False" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Name}" Value="Keys &amp; quest items">
                                                                                <Setter Property="IsExpanded" Value="False" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Expander.Style>
                                                                <Expander.Header>
                                                                    <TextBlock FontWeight="Bold">
                                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="Gray" />
                                                                    </TextBlock>
                                                                </Expander.Header>
                                                                <ItemsPresenter Margin="12,0,0,0" />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Width="250" ToolTip="{Binding PrefabName}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConditionText}" Foreground="Gray" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UnitsText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding ShortName}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                        <DockPanel Grid.Column="2" x:Name="ItemPanel" IsEnabled="False" Margin="6,0,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding PrefabName}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding CategoryName}" Foreground="Gray" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsStackable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Quantity" Width="90" VerticalAlignment="Center" />
                                    <Button Content="−" Width="30" Padding="0,3" Click="DecreaseUnits_Click" />
                                    <TextBox Width="60" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                             Text="{Binding Units, UpdateSourceTrigger=LostFocus}" KeyDown="UnitsBox_KeyDown" />
                                    <Button Content="+" Width="30" Padding="0,3" Click="IncreaseUnits_Click" />
                                </StackPanel>
                                <DockPanel Margin="0,8">
                                    <TextBlock Text="Condition %" Width="90" VerticalAlignment="Center" />
                                    <TextBox DockPanel.Dock="Right" Width="60"
                                             Text="{Binding ConditionPercent, UpdateSourceTrigger=LostFocus}" />
                                    <Slider Minimum="0" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Value="{Binding ConditionPercent}" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Apply JSON" Click="ApplyJson_Click" />
                                    <Button Content="Remove item" Click="RemoveItem_Click" />
                                </StackPanel>
                                <TextBlock Text="Gear data (m_SerializedGear) — edit then click Apply JSON:" Foreground="Gray" />
                            </StackPanel>
                            <TextBox x:Name="GearJsonBox" FontFamily="{StaticResource Mono}" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- Raw JSON -->
                <TabItem Header="Raw JSON">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Section " VerticalAlignment="Center" />
                            <ComboBox x:Name="SectionCombo" Width="420" HorizontalAlignment="Left"
                                      SelectionChanged="SectionCombo_SelectionChanged" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4"
                                   Text="Read-only. Nested JSON strings are expanded for readability." />
                        <TextBox x:Name="RawJsonBox" FontFamily="{StaticResource Mono}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
